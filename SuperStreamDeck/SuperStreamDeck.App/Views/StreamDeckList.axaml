<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:SuperStreamDeck.App.ViewModels"
             xmlns:avalonia="https://github.com/projektanker/icons.avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SuperStreamDeck.App.Views.StreamDeckList"
             x:DataType="viewModels:StreamDeckListViewModel">
    <Design.DataContext>
        <viewModels:StreamDeckListViewModel />
    </Design.DataContext>
    <Grid RowDefinitions="Auto,*" HorizontalAlignment="Stretch">
        <ListBox Grid.Row="1" ItemsSource="{Binding StreamDecks}">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="15" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Margin="0, 0, 5, 0" Text="{Binding DeviceName}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>